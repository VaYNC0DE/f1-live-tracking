{
  "framework": null,
  "buildCommand": "./build.sh",
  "outputDirectory": "dist/wwwroot",
  "headers": [
    {
      "source": "/_framework/(.*).wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!_framework|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
