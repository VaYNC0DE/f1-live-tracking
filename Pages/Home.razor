@page "/"
@using F1LiveTracker.Components
@using F1LiveTracker.Services
@inject TimingTowerState State
@implements IDisposable

<PageTitle>F1 Live Timing Tower | Broadcast Telemetry</PageTitle>

<div class="min-h-screen bg-slate-100 dark:bg-zinc-950 text-slate-900 dark:text-zinc-100 flex flex-col font-sans antialiased transition-colors duration-200">
    <!-- Broadcast Header -->
    <Header />

    <!-- Main Content -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-3 sm:px-6 lg:px-8 py-5 flex flex-col gap-4">
        <!-- Track & Safety Car Status -->
        <TrackStatusBar />

        <!-- Sub-Header 4 Broadcast Metric Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
            <!-- Race Leader -->
            <div class="flex items-center justify-between px-4 py-2.5 bg-white dark:bg-zinc-900/70 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm">
                <div class="flex items-center space-x-2.5">
                    <div class="w-8 h-8 rounded-md bg-amber-500/10 dark:bg-amber-500/20 border border-amber-500/30 dark:border-amber-500/40 flex items-center justify-center font-bold text-amber-500 text-xs">
                        P1
                    </div>
                    <div>
                        <div class="text-[10px] font-mono font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">
                            RACE LEADER
                        </div>
                        <div class="text-xs sm:text-sm font-black font-mono text-slate-900 dark:text-zinc-100">
                            @if (State.Drivers.Count > 0)
                            {
                                var leader = State.Drivers[0];
                                <span class="mr-1.5">@leader.NameAcronym</span>
                                <span class="text-xs text-slate-500 dark:text-zinc-400 font-sans font-normal truncate max-w-[100px] inline-block align-bottom">
                                    (@leader.TeamName)
                                </span>
                            }
                            else
                            {
                                <span class="text-slate-400 dark:text-zinc-500">P1 INITIALIZING</span>
                            }
                        </div>
                    </div>
                </div>
                @if (State.Drivers.Count > 0)
                {
                    <div class="w-2 h-7 rounded-sm shadow-sm flex-shrink-0"
                         style="background-color: @State.Drivers[0].TeamColor;"></div>
                }
            </div>

            <!-- Fastest Lap -->
            @{
                var flDriver = State.Drivers.FirstOrDefault(d => d.IsFastestLap);
            }
            <div class="flex items-center justify-between px-4 py-2.5 bg-white dark:bg-zinc-900/70 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm">
                <div class="flex items-center space-x-2.5">
                    <div class="w-8 h-8 rounded-md bg-[#B138DD]/10 dark:bg-[#B138DD]/20 border border-[#B138DD]/30 dark:border-[#B138DD]/40 flex items-center justify-center font-bold text-[#B138DD] text-xs">
                        FL
                    </div>
                    <div>
                        <div class="text-[10px] font-mono font-bold uppercase tracking-wider text-[#B138DD]">
                            FASTEST LAP
                        </div>
                        <div class="text-xs sm:text-sm font-black font-mono text-slate-900 dark:text-zinc-100">
                            @if (flDriver != null)
                            {
                                <span class="text-slate-800 dark:text-zinc-200 mr-1.5">@flDriver.NameAcronym</span>
                                <span class="text-[#B138DD] font-bold">
                                    @FormatUtils.FormatLapTime(flDriver.LastLapTime)
                                </span>
                            }
                            else
                            {
                                <span class="text-slate-400 dark:text-zinc-500">AWAITING CLASSIFICATION</span>
                            }
                        </div>
                    </div>
                </div>
                @if (flDriver != null)
                {
                    <div class="w-2 h-7 rounded-sm shadow-sm flex-shrink-0"
                         style="background-color: @flDriver.TeamColor;"></div>
                }
            </div>

            <!-- Fastest Pit Stop -->
            <div class="flex items-center justify-between px-4 py-2.5 bg-white dark:bg-zinc-900/70 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm">
                <div class="flex items-center space-x-2.5">
                    <div class="w-8 h-8 rounded-md bg-amber-500/10 dark:bg-amber-500/20 border border-amber-500/30 dark:border-amber-500/40 flex items-center justify-center font-bold text-amber-500 text-xs">
                        PIT
                    </div>
                    <div>
                        <div class="flex items-center space-x-1.5">
                            <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">
                                FASTEST PIT STOP
                            </span>
                            @if (State.SessionFastestPitStop != null)
                            {
                                <span class="text-[9px] font-mono font-bold px-1 rounded bg-slate-100 dark:bg-zinc-800 text-slate-600 dark:text-zinc-400 border border-slate-200 dark:border-slate-800">
                                    @(State.SessionFastestPitStop.IsStationary ? "BOX" : "LANE")
                                </span>
                            }
                        </div>
                        <div class="text-xs sm:text-sm font-black font-mono text-slate-900 dark:text-zinc-100">
                            @if (State.SessionFastestPitStop != null)
                            {
                                var pit = State.SessionFastestPitStop;
                                <span class="text-slate-800 dark:text-zinc-200 mr-1.5">@pit.NameAcronym</span>
                                <span class="text-amber-600 dark:text-amber-400 font-bold">@pit.Duration.ToString("F2")s</span>
                                <span class="text-[11px] font-normal text-slate-400 dark:text-zinc-500 ml-1.5">(L@(pit.LapNumber))</span>
                            }
                            else
                            {
                                <span class="text-slate-400 dark:text-zinc-500">NO STOPS RECORDED</span>
                            }
                        </div>
                    </div>
                </div>
                @if (State.SessionFastestPitStop != null)
                {
                    <div class="w-2 h-7 rounded-sm shadow-sm flex-shrink-0"
                         style="background-color: @State.SessionFastestPitStop.TeamColor;"></div>
                }
            </div>

            <!-- Telemetry Engine Stream Status -->
            <div class="flex items-center justify-between px-4 py-2.5 bg-white dark:bg-zinc-900/70 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm">
                <div class="flex items-center space-x-2.5">
                    <div class="w-8 h-8 rounded-md bg-emerald-500/10 dark:bg-emerald-500/20 border border-emerald-500/30 dark:border-emerald-500/40 flex items-center justify-center font-bold text-emerald-600 text-xs">
                        ⚡
                    </div>
                    <div>
                        <div class="text-[10px] font-mono font-bold uppercase tracking-wider text-slate-500 dark:text-zinc-400">
                            TELEMETRY ENGINE
                        </div>
                        <div class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-zinc-200">
                            C# Blazor WebAssembly
                        </div>
                    </div>
                </div>
                <div class="text-[10px] font-mono text-slate-600 dark:text-zinc-400 bg-slate-100 dark:bg-zinc-950 px-2 py-1 rounded border border-slate-200 dark:border-slate-800 flex-shrink-0">
                    5s POLLING
                </div>
            </div>
        </div>

        <!-- Main Layout: Timing Tower (Left) & Cockpit + Pit Stops (Right) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
            <div class="lg:col-span-7 xl:col-span-8 flex flex-col gap-4">
                <TimingTower />
            </div>

            <div class="lg:col-span-5 xl:col-span-4 flex flex-col gap-4">
                <CockpitTelemetryCard />
                <PitStopCard />
            </div>
        </div>

        <!-- Footer Legend -->
        <div class="mt-2 py-3 px-4 bg-white/90 dark:bg-zinc-900/40 border border-slate-200 dark:border-slate-800/80 rounded-lg flex flex-wrap items-center justify-between gap-3 text-xs text-slate-600 dark:text-zinc-400 shadow-sm transition-colors">
            <div class="flex items-center flex-wrap gap-2 sm:gap-3">
                <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-zinc-500">
                    Compounds:
                </span>
                <div class="flex items-center space-x-1">
                    <span class="w-3.5 h-3.5 rounded-full bg-red-500/20 border border-red-500 text-red-500 text-[9px] font-black flex items-center justify-center">S</span>
                    <span class="text-[11px]">Soft</span>
                </div>
                <div class="flex items-center space-x-1">
                    <span class="w-3.5 h-3.5 rounded-full bg-yellow-500/20 border border-yellow-500 text-yellow-600 dark:text-yellow-400 text-[9px] font-black flex items-center justify-center">M</span>
                    <span class="text-[11px]">Medium</span>
                </div>
                <div class="flex items-center space-x-1">
                    <span class="w-3.5 h-3.5 rounded-full bg-slate-200 border border-slate-400 text-slate-800 text-[9px] font-black flex items-center justify-center">H</span>
                    <span class="text-[11px]">Hard</span>
                </div>
                <div class="flex items-center space-x-1">
                    <span class="w-3.5 h-3.5 rounded-full bg-emerald-500/20 border border-emerald-500 text-emerald-600 dark:text-emerald-400 text-[9px] font-black flex items-center justify-center">I</span>
                    <span class="text-[11px]">Inter</span>
                </div>
                <div class="flex items-center space-x-1">
                    <span class="w-3.5 h-3.5 rounded-full bg-blue-500/20 border border-blue-500 text-blue-600 dark:text-blue-400 text-[9px] font-black flex items-center justify-center">W</span>
                    <span class="text-[11px]">Wet</span>
                </div>
            </div>

            <div class="flex items-center flex-wrap gap-4">
                <div class="flex items-center space-x-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-[#B138DD]"></span>
                    <span class="text-[#B138DD] font-mono text-[11px] font-semibold">Fastest Session Lap</span>
                </div>
                <div class="flex items-center space-x-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    <span class="text-emerald-600 dark:text-emerald-300 font-mono text-[11px] font-medium">Personal Best</span>
                </div>
                <div class="flex items-center space-x-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                    <span class="text-amber-600 dark:text-amber-300 font-mono text-[11px] font-semibold">Fastest Pit Stop</span>
                </div>
                <div class="flex items-center space-x-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-cyan-500"></span>
                    <span class="text-cyan-600 dark:text-cyan-300 font-mono text-[11px] font-semibold">DRS Eligible (&lt; 1.0s)</span>
                </div>
            </div>
        </div>
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnStateChanged;
        await State.InitializeAsync();
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
    }
}
