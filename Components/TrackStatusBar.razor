@using F1LiveTracker.Services
@inject TimingTowerState State
@implements IDisposable

<div class="flex flex-col gap-2.5 w-full">
    <!-- Red Flag Active Banner -->
    @if (State.RaceControlStatus.Type == "RED")
    {
        <div class="flex items-center justify-between px-4 py-2.5 rounded-lg bg-red-600/15 dark:bg-red-600/20 border border-red-500 shadow-[0_0_24px_rgba(239,68,68,0.3)] animate-pulse text-red-900 dark:text-red-200">
            <div class="flex items-center space-x-2.5">
                <span class="relative flex h-3 w-3">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-500 opacity-90"></span>
                    <span class="relative inline-flex rounded-full h-3 w-3 bg-red-600"></span>
                </span>
                <div>
                    <span class="font-mono text-xs sm:text-sm font-black uppercase tracking-wider text-red-700 dark:text-red-300">
                        RED FLAG — @State.RaceControlStatus.Label
                    </span>
                    <span class="hidden sm:inline font-mono text-xs text-red-600/80 dark:text-red-400/80 ml-2">
                        • All Cars Return to Pit Lane • Session Clock Stopped
                    </span>
                </div>
            </div>
            <span class="text-[10px] font-mono font-black uppercase px-2 py-0.5 rounded bg-red-600 text-white border border-red-400 shadow-sm">
                RED FLAG
            </span>
        </div>
    }

    <!-- Environmental & Track Status Bar -->
    <div class="px-3.5 py-2.5 bg-white dark:bg-zinc-900/70 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm flex flex-wrap items-center justify-between gap-3 text-xs transition-colors">
        <div class="flex items-center flex-wrap gap-2 sm:gap-3">
            <!-- Safety Car Status Badge -->
            <div class="flex items-center space-x-1.5 px-2.5 py-1 rounded-md border font-mono text-[11px] font-bold @(State.CurrentTrackState.SafetyCarStatus == "OFF" ? "bg-emerald-50 dark:bg-emerald-500/10 border-emerald-300 dark:border-emerald-500/30 text-emerald-700 dark:text-emerald-400" : "bg-amber-500/20 border-amber-500/60 text-amber-700 dark:text-amber-300 shadow-[0_0_10px_rgba(245,158,11,0.25)]")">
                <span>🛡️ SAFETY CAR: @State.CurrentTrackState.SafetyCarStatus</span>
            </div>

            <!-- Race Control Status Badge -->
            <div class="flex items-center space-x-1.5 px-2.5 py-1 rounded-md border font-mono text-[11px] font-black @(State.RaceControlStatus.Type == "RED" ? "bg-red-500/15 dark:bg-red-500/20 border-red-400 dark:border-red-500 text-red-600 dark:text-red-300" : "bg-emerald-50 dark:bg-emerald-500/10 border-emerald-300 dark:border-emerald-500/30 text-emerald-700 dark:text-emerald-400")">
                <span class="w-2 h-2 rounded-full @(State.RaceControlStatus.Type == "RED" ? "bg-red-600 animate-ping" : "bg-emerald-500")"></span>
                <span class="uppercase tracking-wider">@State.RaceControlStatus.Label</span>
            </div>

            <!-- Track Surface Condition -->
            <div class="flex items-center space-x-1.5 px-2 py-1 rounded-md border font-mono text-[11px] font-bold bg-slate-100 dark:bg-zinc-900 border-slate-300 dark:border-slate-700 text-slate-800 dark:text-zinc-200">
                <span class="w-2 h-2 rounded-full @(State.CurrentTrackState.Condition == "WET" ? "bg-blue-500" : "bg-emerald-500")"></span>
                <span>TRACK: @State.CurrentTrackState.Condition</span>
            </div>

            <!-- DRS State -->
            <div class="flex items-center space-x-1.5 px-2 py-1 rounded-md border font-mono text-[11px] font-bold @(State.CurrentTrackState.DrsStatus == "ENABLED" ? "bg-cyan-500/15 border-cyan-400 dark:border-cyan-500/50 text-cyan-700 dark:text-cyan-300" : "bg-slate-100 dark:bg-zinc-900 border-slate-300 dark:border-slate-800 text-slate-500 dark:text-zinc-500")">
                <span>⚡ DRS @State.CurrentTrackState.DrsStatus</span>
            </div>
        </div>

        <!-- Weather Readings -->
        <div class="flex items-center flex-wrap gap-2.5 sm:gap-4 font-mono text-[11px] text-slate-600 dark:text-zinc-400">
            <div>
                <span class="text-slate-400 dark:text-zinc-500">Track:</span>
                <span class="text-slate-900 dark:text-zinc-200 font-bold ml-1">
                    @(State.CurrentTrackState.TrackTemp.HasValue ? $"{State.CurrentTrackState.TrackTemp.Value:F1}°C" : "33.9°C")
                </span>
            </div>
            <div>
                <span class="text-slate-400 dark:text-zinc-500">Air:</span>
                <span class="text-slate-900 dark:text-zinc-200 font-bold ml-1">
                    @(State.CurrentTrackState.AirTemp.HasValue ? $"{State.CurrentTrackState.AirTemp.Value:F1}°C" : "23.8°C")
                </span>
            </div>
            <div class="hidden sm:inline">
                <span class="text-slate-400 dark:text-zinc-500">Hum:</span>
                <span class="text-slate-900 dark:text-zinc-200 font-semibold ml-1">
                    @(State.CurrentTrackState.Humidity.HasValue ? $"{State.CurrentTrackState.Humidity.Value:F0}%" : "39%")
                </span>
            </div>
            <div class="hidden sm:inline">
                <span class="text-slate-400 dark:text-zinc-500">Wind:</span>
                <span class="text-slate-900 dark:text-zinc-200 font-semibold ml-1">
                    @(State.CurrentTrackState.WindSpeed.HasValue ? $"{State.CurrentTrackState.WindSpeed.Value:F1} m/s" : "1.5 m/s")
                </span>
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
    }
}
