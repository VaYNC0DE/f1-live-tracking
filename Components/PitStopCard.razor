@using F1LiveTracker.Services
@inject TimingTowerState State

<div class="w-full bg-white dark:bg-zinc-950/90 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm dark:shadow-xl backdrop-blur-sm flex flex-col overflow-hidden transition-colors">
    <!-- Card Header -->
    <div class="flex items-center justify-between px-4 py-3 bg-slate-100 dark:bg-zinc-900/95 border-b border-slate-200 dark:border-slate-800">
        <div class="flex items-center space-x-2.5">
            <div class="w-7 h-7 rounded-md bg-amber-500/10 dark:bg-amber-500/20 border border-amber-500/30 dark:border-amber-500/40 flex items-center justify-center">
                <span class="text-xs">🔧</span>
            </div>
            <div>
                <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-800 dark:text-zinc-200">
                    Pit Stops & Strategy
                </h3>
                <p class="text-[10px] font-mono text-slate-500 dark:text-zinc-500">
                    Stationary Box & Lane Telemetry
                </p>
            </div>
        </div>

        <div class="flex items-center space-x-2">
            @if (State.PitStops.Count > 0)
            {
                <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold text-amber-600 dark:text-amber-400 bg-amber-500/10 border border-amber-500/30">
                    @State.PitStops.Count @(State.PitStops.Count == 1 ? "STOP" : "STOPS")
                </span>
            }
            else
            {
                <span class="px-2 py-0.5 rounded text-[10px] font-mono text-slate-500 dark:text-zinc-500 bg-slate-100 dark:bg-zinc-900 border border-slate-200 dark:border-slate-800">
                    STANDBY
                </span>
            }
        </div>
    </div>

    <div class="p-4 flex flex-col gap-3">
        @if (State.SessionFastestPitStop != null)
        {
            var p = State.SessionFastestPitStop;
            <div class="relative overflow-hidden rounded-lg bg-gradient-to-r from-amber-500/10 via-amber-500/5 to-transparent dark:from-amber-500/15 dark:via-zinc-900/60 dark:to-zinc-900/30 border border-amber-500/40 p-3.5 shadow-sm">
                <div class="flex items-start justify-between">
                    <div class="flex items-center space-x-2 mb-1.5">
                        <span class="text-[10px] font-mono font-black uppercase tracking-wider text-amber-600 dark:text-amber-400">
                            🏆 FASTEST PIT STOP OF SESSION
                        </span>
                    </div>
                    <span class="text-[9px] font-mono font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-400/50">
                        @(p.IsStationary ? "Stationary Box" : "Pit Lane Transit")
                    </span>
                </div>

                <div class="flex items-center justify-between mt-1">
                    <div class="flex items-center space-x-3">
                        <div class="w-1.5 h-10 rounded-full flex-shrink-0 shadow-sm" style="background-color: @p.TeamColor;"></div>

                        <div class="w-10 h-10 rounded-full overflow-hidden bg-slate-100 dark:bg-zinc-900 border border-amber-500/40 flex items-center justify-center flex-shrink-0 font-mono text-xs font-bold text-amber-600 dark:text-amber-300">
                            @p.NameAcronym
                        </div>

                        <div>
                            <div class="flex items-baseline space-x-1.5">
                                <span class="text-base font-black font-mono text-slate-900 dark:text-zinc-100">
                                    @p.NameAcronym
                                </span>
                                <span class="text-xs font-mono text-slate-400 dark:text-zinc-400">
                                    #@p.DriverNumber
                                </span>
                            </div>
                            <div class="text-[11px] text-slate-500 dark:text-zinc-400 truncate max-w-[140px] sm:max-w-[200px]">
                                @p.TeamName • Lap @p.LapNumber
                            </div>
                        </div>
                    </div>

                    <div class="text-right">
                        <div class="text-2xl sm:text-3xl font-black font-mono tracking-tight text-amber-600 dark:text-amber-400">
                            @p.Duration.ToString("F2")s
                        </div>
                        <div class="text-[9px] font-mono uppercase tracking-wider text-slate-400 dark:text-zinc-500">
                            @(p.IsStationary ? "DHL Award Metric" : "Pit Transit Time")
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="rounded-lg bg-slate-50 dark:bg-zinc-900/40 border border-slate-200 dark:border-slate-800/80 p-5 text-center">
                <div class="text-xs font-mono font-bold uppercase text-slate-700 dark:text-zinc-300 mb-1">
                    No Pit Stops Recorded Yet
                </div>
                <p class="text-[11px] font-mono text-slate-400 dark:text-zinc-500 max-w-xs mx-auto">
                    Telemetry automatically ranks pit stop durations once cars transit through the pit lane.
                </p>
            </div>
        }

        <!-- Top 5 Leaderboard -->
        @if (State.PitStops.Count > 0)
        {
            <div class="mt-1">
                <div class="flex items-center justify-between text-[10px] font-mono uppercase tracking-wider text-slate-500 dark:text-zinc-500 pb-1.5 px-2 border-b border-slate-200 dark:border-slate-800">
                    <span>Fastest Stops</span>
                    <span>Duration</span>
                </div>

                <div class="divide-y divide-slate-200 dark:divide-slate-800/50">
                    @for (int i = 0; i < Math.Min(5, State.PitStops.Count); i++)
                    {
                        var stop = State.PitStops[i];
                        var isFastest = i == 0;

                        <div class="flex items-center justify-between py-2 px-2 rounded transition-colors @(isFastest ? "bg-amber-500/10 dark:bg-amber-500/5" : "hover:bg-slate-100 dark:hover:bg-zinc-900/40")">
                            <div class="flex items-center space-x-2.5 min-w-0">
                                <span class="w-4 font-mono text-xs font-bold text-center @(isFastest ? "text-amber-600 dark:text-amber-400" : "text-slate-400 dark:text-zinc-500")">
                                    @(i + 1)
                                </span>

                                <div class="w-1 h-5 rounded-full flex-shrink-0 shadow-sm" style="background-color: @stop.TeamColor;"></div>

                                <span class="font-mono text-xs font-bold text-slate-800 dark:text-zinc-200">
                                    @stop.NameAcronym
                                </span>
                                <span class="text-[11px] font-mono text-slate-400 dark:text-zinc-500">
                                    Lap @stop.LapNumber
                                </span>
                                <span class="text-[10px] text-slate-400 dark:text-zinc-500 truncate max-w-[100px] hidden sm:inline">
                                    @stop.TeamName
                                </span>
                            </div>

                            <div class="flex items-center space-x-2">
                                <span class="text-xs font-mono font-bold @(isFastest ? "text-amber-600 dark:text-amber-400" : "text-slate-700 dark:text-zinc-300")">
                                    @stop.Duration.ToString("F2")s
                                </span>
                                <span class="text-[9px] font-mono uppercase px-1 py-0.5 rounded bg-slate-100 dark:bg-zinc-900 text-slate-500 dark:text-zinc-500 border border-slate-200 dark:border-slate-800">
                                    @(stop.IsStationary ? "BOX" : "LANE")
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
