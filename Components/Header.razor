@using F1LiveTracker.Services
@inject TimingTowerState State
@inject ThemeState Theme
@implements IDisposable

<header class="w-full bg-white/95 dark:bg-zinc-950 border-b border-slate-200 dark:border-slate-800 shadow-sm dark:shadow-xl backdrop-blur-md sticky top-0 z-50 transition-colors duration-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
            <!-- Left section: F1 Brand pill, Session Title & Circuit -->
            <div class="flex items-center space-x-3.5">
                <div class="w-10 h-10 rounded-lg bg-red-600 flex items-center justify-center font-black text-white text-base tracking-tighter shadow-[0_0_15px_rgba(220,38,38,0.4)] flex-shrink-0">
                    F1
                </div>

                <div>
                    <div class="flex flex-wrap items-center gap-2">
                        <h1 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-zinc-100 uppercase font-sans">
                            @(State.CurrentSession != null ? $"{State.CurrentSession.Year} {State.CurrentSession.CountryName ?? State.CurrentSession.Location} Grand Prix" : "Formula 1 Grand Prix")
                        </h1>
                        <span class="px-2 py-0.5 rounded text-[11px] font-mono font-bold bg-slate-100 dark:bg-zinc-900 border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-zinc-300 uppercase">
                            @(State.CurrentSession?.SessionName ?? "Race Session")
                        </span>

                        <!-- Season Year Dropdown -->
                        <select value="@State.SelectedYear" @onchange="OnYearChanged"
                                aria-label="Select F1 Season Year"
                                class="bg-slate-100 dark:bg-zinc-900 border border-slate-300 dark:border-slate-700 hover:border-red-500/70 text-slate-900 dark:text-zinc-100 text-xs font-mono font-bold rounded-md px-2.5 py-1 focus:outline-none focus:ring-1 focus:ring-red-500 transition-colors cursor-pointer shadow-sm">
                            <option value="2026">2026 SEASON</option>
                            <option value="2025">2025 SEASON</option>
                            <option value="2024">2024 SEASON</option>
                            <option value="2023">2023 SEASON</option>
                        </select>

                        <!-- Session / Grand Prix Selector Dropdown -->
                        @if (State.AvailableSessions.Count > 0)
                        {
                            <select value="@(State.SelectedSessionKey ?? State.CurrentSession?.SessionKey ?? 0)" @onchange="OnSessionChanged"
                                    aria-label="Select Grand Prix Session"
                                    class="bg-slate-100 dark:bg-zinc-900 border border-slate-300 dark:border-slate-700 hover:border-slate-500 text-slate-800 dark:text-zinc-200 text-xs font-mono font-semibold rounded-md px-2.5 py-1 focus:outline-none focus:ring-1 focus:ring-red-500 transition-colors cursor-pointer max-w-[210px] sm:max-w-[280px] truncate shadow-sm">
                                @foreach (var s in State.AvailableSessions)
                                {
                                    <option value="@s.SessionKey">@($"{s.Year} {s.CountryName ?? s.CircuitShortName} - {s.SessionName}")</option>
                                }
                            </select>
                        }
                    </div>
                    <div class="flex items-center space-x-2 text-xs text-slate-500 dark:text-zinc-400 mt-0.5 font-medium">
                        <span>🚩 @(State.CurrentSession?.CircuitShortName ?? "Marina Bay") Circuit</span>
                        <span class="text-slate-300 dark:text-zinc-600">•</span>
                        <span>@(State.CurrentSession?.Location ?? "Singapore")</span>
                    </div>
                </div>
            </div>

            <!-- Right section: Lap/Time Counter, LIVE SYNC badge, Light/Dark Toggle & GitHub Link -->
            <div class="flex items-center justify-between md:justify-end space-x-2 sm:space-x-2.5">
                <div class="flex items-center space-x-3 bg-slate-100/90 dark:bg-zinc-900/90 border border-slate-200 dark:border-slate-800 px-3.5 py-1.5 rounded-lg shadow-inner">
                    <div class="flex items-center space-x-2 border-r border-slate-300 dark:border-slate-800 pr-3">
                        <div>
                            <div class="text-[9px] font-mono font-bold uppercase tracking-wider text-slate-500 dark:text-zinc-500 leading-none">
                                LAP
                            </div>
                            <div class="text-xs sm:text-sm font-mono font-black text-slate-900 dark:text-zinc-100 leading-tight">
                                @(State.Drivers.Count > 0 ? State.Drivers.Max(d => d.TyreAgeLaps) : 71) / 71
                            </div>
                        </div>
                    </div>

                    <div>
                        <div class="text-[9px] font-mono font-bold uppercase tracking-wider text-slate-500 dark:text-zinc-500 leading-none">
                            SESSION CLOCK
                        </div>
                        <div class="text-xs sm:text-sm font-mono font-black text-slate-900 dark:text-zinc-100 leading-tight">
                            @ClockTime
                        </div>
                    </div>
                </div>

                <!-- Green pulsing LIVE SYNC badge -->
                <div class="flex items-center space-x-2 px-3 py-1.5 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-400/80 dark:border-emerald-500/50 shadow-[0_0_12px_rgba(16,185,129,0.2)] dark:shadow-[0_0_15px_rgba(16,185,129,0.3)] animate-pulse flex-shrink-0"
                     title="Live OpenF1 Telemetry Engine Connected">
                    <span class="relative flex h-2.5 w-2.5">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 dark:bg-emerald-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-600 dark:bg-emerald-500"></span>
                    </span>
                    <span class="font-mono text-xs font-black tracking-widest text-emerald-700 dark:text-emerald-400 uppercase">
                        LIVE SYNC
                    </span>
                </div>

                <!-- Light / Dark Mode Toggle Button -->
                <button type="button" @onclick="Theme.ToggleThemeAsync"
                        aria-label="Toggle Theme"
                        class="p-2 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-zinc-900/90 dark:hover:bg-zinc-800 border border-slate-300 dark:border-slate-800 text-slate-700 dark:text-zinc-300 hover:text-amber-500 dark:hover:text-amber-400 transition-colors shadow-sm flex items-center justify-center cursor-pointer flex-shrink-0">
                    @if (Theme.CurrentTheme == "light")
                    {
                        <span class="text-xs">🌙</span>
                    }
                    else
                    {
                        <span class="text-xs">☀️</span>
                    }
                </button>

                <!-- GitHub Repository Link Button -->
                <a href="https://github.com/VaYNC0DE/f1-live-tracking" target="_blank" rel="noopener noreferrer"
                   aria-label="View source code on GitHub"
                   class="p-2 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-zinc-900/90 dark:hover:bg-zinc-800 border border-slate-300 dark:border-slate-800 text-slate-700 dark:text-zinc-300 hover:text-slate-900 dark:hover:text-white transition-colors shadow-sm flex items-center justify-center cursor-pointer flex-shrink-0 font-bold text-xs">
                    GH
                </a>
            </div>
        </div>
    </div>
</header>

@code {
    private string ClockTime = DateTime.UtcNow.ToString("HH:mm:ss") + " UTC";
    private System.Threading.Timer? _clockTimer;

    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
        _clockTimer = new System.Threading.Timer(_ =>
        {
            ClockTime = DateTime.UtcNow.ToString("HH:mm:ss") + " UTC";
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
        _clockTimer?.Dispose();
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var yr))
        {
            await State.ChangeYearAsync(yr);
        }
    }

    private async Task OnSessionChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var key))
        {
            await State.SelectSessionAsync(key);
        }
    }
}
