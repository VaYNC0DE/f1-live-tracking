@using F1LiveTracker.Services
@inject TimingTowerState State
@implements IDisposable

<div class="w-full bg-white dark:bg-zinc-950/90 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm dark:shadow-xl backdrop-blur-sm flex flex-col overflow-hidden transition-colors">
    <!-- Header -->
    <div class="flex items-center justify-between px-4 py-3 bg-slate-100 dark:bg-zinc-900/95 border-b border-slate-200 dark:border-slate-800">
        <div class="flex items-center space-x-2.5">
            <div class="w-7 h-7 rounded-md bg-cyan-500/10 dark:bg-cyan-500/20 border border-cyan-500/30 dark:border-cyan-500/40 flex items-center justify-center">
                <span class="text-xs">⏱️</span>
            </div>
            <div>
                <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-800 dark:text-zinc-200">
                    Cockpit & DRS Wing Telemetry
                </h3>
                <p class="text-[10px] font-mono text-slate-500 dark:text-zinc-500">
                    Single-Car High Frequency Feed
                </p>
            </div>
        </div>

        <div class="flex items-center space-x-2">
            <span class="inline-flex items-center space-x-1.5 px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase tracking-wider text-red-500 dark:text-red-400 bg-red-500/10 border border-red-500/30">
                <span class="relative flex h-1.5 w-1.5">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-90"></span>
                    <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-red-500"></span>
                </span>
                <span>ONBOARD</span>
            </span>
        </div>
    </div>

    <div class="p-4 flex flex-col gap-3.5">
        @if (State.CockpitTelemetry != null)
        {
            var telem = State.CockpitTelemetry;
            var maxRpm = 12500;
            var filledLeds = Math.Min(15, Math.Max(0, (int)Math.Round((double)telem.Rpm / maxRpm * 15)));

            <!-- Selected Driver Banner -->
            <div class="flex items-center justify-between p-3 rounded-lg bg-slate-50 dark:bg-zinc-900/60 border border-slate-200 dark:border-slate-800">
                <div class="flex items-center space-x-3 min-w-0">
                    <div class="w-1.5 h-9 rounded-full flex-shrink-0 shadow-sm" style="background-color: @telem.TeamColor;"></div>

                    <div class="w-9 h-9 rounded-full overflow-hidden bg-slate-100 dark:bg-zinc-900 border border-slate-200 dark:border-slate-700 flex items-center justify-center flex-shrink-0 font-mono text-xs font-bold text-slate-700 dark:text-zinc-300">
                        @telem.NameAcronym
                    </div>

                    <div class="min-w-0">
                        <div class="flex items-baseline space-x-1.5">
                            <span class="text-sm font-black font-mono text-slate-900 dark:text-zinc-100">
                                @telem.NameAcronym
                            </span>
                            <span class="text-xs font-mono text-slate-400 dark:text-zinc-500">
                                #@telem.DriverNumber
                            </span>
                        </div>
                        <div class="text-[11px] text-slate-500 dark:text-zinc-400 truncate">
                            @telem.TeamName
                        </div>
                    </div>
                </div>

                <div class="text-right flex-shrink-0">
                    <div class="text-[9px] font-mono uppercase text-slate-400 dark:text-zinc-500">Status</div>
                    <div class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400">TRACKSIDE</div>
                </div>
            </div>

            <!-- Hero DRS Rear Wing Flap Status Display -->
            <div class="p-3.5 rounded-lg border transition-all duration-300 @(telem.IsDrsOpen ? "bg-emerald-500/15 dark:bg-emerald-950/40 border-emerald-500 text-emerald-800 dark:text-emerald-200 animate-pulse" : "bg-slate-50 dark:bg-zinc-900/80 border-slate-200 dark:border-slate-800 text-slate-800 dark:text-zinc-300")">
                <div class="flex items-center justify-between mb-1">
                    <div class="flex items-center space-x-2">
                        <span class="text-xs">⚡</span>
                        <span class="text-xs font-mono font-black uppercase tracking-wider">
                            @(telem.IsDrsOpen ? "DRS REAR WING FLAP: OPEN" : "DRS REAR WING FLAP: CLOSED")
                        </span>
                    </div>
                    <span class="text-[10px] font-mono font-bold uppercase px-2 py-0.5 rounded border @(telem.IsDrsOpen ? "bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 border-emerald-400/60" : "bg-slate-200 dark:bg-zinc-800 text-slate-600 dark:text-zinc-500 border-slate-300 dark:border-slate-700")">
                        @(telem.IsDrsOpen ? "WING DEPLOYED" : "HIGH DOWNFORCE")
                    </span>
                </div>
                <p class="text-[11px] font-mono text-slate-500 dark:text-zinc-400">
                    @(telem.IsDrsOpen
                        ? "Physical rear wing flap opened down straight — Aerodynamic drag minimized for overtaking."
                        : "Flap closed in standard cornering / high downforce configuration.")
                </p>
            </div>

            <!-- Speedometer, Gear Readout & Steering Rev Bar -->
            <div class="grid grid-cols-2 gap-2.5">
                <div class="p-3 rounded-lg bg-slate-50 dark:bg-zinc-900/70 border border-slate-200 dark:border-slate-800 flex items-center justify-between">
                    <div>
                        <div class="text-[9px] font-mono font-bold uppercase text-slate-400 dark:text-zinc-500">SPEED</div>
                        <div class="text-2xl font-black font-mono text-slate-900 dark:text-zinc-100 tracking-tight">
                            @telem.Speed <span class="text-xs font-normal text-slate-400 dark:text-zinc-500">KM/H</span>
                        </div>
                    </div>

                    <div class="w-12 h-12 rounded-lg bg-white dark:bg-zinc-950 border border-slate-300 dark:border-slate-700 flex flex-col items-center justify-center shadow-inner">
                        <span class="text-[8px] font-mono uppercase text-slate-400 dark:text-zinc-500 leading-none">GEAR</span>
                        <span class="text-lg font-black font-mono text-amber-500 dark:text-amber-400 leading-none mt-0.5">
                            @(telem.Gear == 0 ? "N" : telem.Gear.ToString())
                        </span>
                    </div>
                </div>

                <div class="p-3 rounded-lg bg-slate-50 dark:bg-zinc-900/70 border border-slate-200 dark:border-slate-800 flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="text-[9px] font-mono font-bold uppercase text-slate-400 dark:text-zinc-500">REV COUNTER</span>
                        <span class="text-xs font-mono font-bold text-slate-800 dark:text-zinc-300">
                            @telem.Rpm.ToString("N0") <span class="text-[9px] text-slate-400 dark:text-zinc-500">RPM</span>
                        </span>
                    </div>

                    <!-- 15-LED Shift Light Bar -->
                    <div class="flex items-center space-x-1 mt-2">
                        @for (int i = 0; i < 15; i++)
                        {
                            var isFilled = i < filledLeds;
                            var color = i >= 13 ? "bg-purple-500 animate-pulse" : i >= 10 ? "bg-red-500" : i >= 5 ? "bg-amber-400" : "bg-emerald-500";
                            <div class="h-4 flex-1 rounded-sm transition-colors duration-150 @(isFilled ? color : "bg-slate-200 dark:bg-zinc-800")"></div>
                        }
                    </div>
                </div>
            </div>

            <!-- Throttle & Brake Pedals Telemetry -->
            <div class="p-3 rounded-lg bg-slate-50 dark:bg-zinc-900/70 border border-slate-200 dark:border-slate-800 flex flex-col gap-2.5">
                <div>
                    <div class="flex items-center justify-between text-[10px] font-mono font-bold mb-1">
                        <span class="text-emerald-600 dark:text-emerald-400 uppercase">THROTTLE</span>
                        <span class="text-slate-800 dark:text-zinc-200">@telem.Throttle%</span>
                    </div>
                    <div class="w-full h-2.5 rounded-full bg-slate-200 dark:bg-zinc-950 border border-slate-300 dark:border-slate-800 overflow-hidden">
                        <div class="h-full bg-emerald-500 rounded-full transition-all duration-200" style="width: @(Math.Clamp(telem.Throttle, 0, 100))%;"></div>
                    </div>
                </div>

                <div>
                    <div class="flex items-center justify-between text-[10px] font-mono font-bold mb-1">
                        <span class="text-red-500 dark:text-red-400 uppercase">BRAKE</span>
                        <span class="text-slate-800 dark:text-zinc-200">@telem.Brake%</span>
                    </div>
                    <div class="w-full h-2.5 rounded-full bg-slate-200 dark:bg-zinc-950 border border-slate-300 dark:border-slate-800 overflow-hidden">
                        <div class="h-full bg-red-500 rounded-full transition-all duration-200" style="width: @(Math.Clamp(telem.Brake, 0, 100))%;"></div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="p-6 text-center rounded-lg bg-slate-50 dark:bg-zinc-900/40 border border-slate-200 dark:border-slate-800 text-xs text-slate-500 dark:text-zinc-400 font-mono">
                Click any driver in the timing tower to tune into live telemetry feed
            </div>
        }

        <!-- Quick Driver Switcher Buttons Bar -->
        <div>
            <div class="text-[10px] font-mono uppercase text-slate-500 dark:text-zinc-500 mb-1.5 flex items-center justify-between">
                <span>Switch Driver Cockpit:</span>
                <span class="text-[9px] text-slate-400 dark:text-zinc-500">Click any car to tune in</span>
            </div>

            <div class="flex flex-wrap gap-1.5 max-h-24 overflow-y-auto pr-1">
                @foreach (var d in State.Drivers)
                {
                    var isSelected = State.SelectedCockpitDriverNumber == d.DriverNumber;
                    <button type="button" @onclick="() => State.SelectCockpitDriver(d.DriverNumber)"
                            class="px-2 py-1 rounded text-[11px] font-mono font-bold border transition-all cursor-pointer inline-flex items-center space-x-1.5 @(isSelected ? "border-cyan-500 text-cyan-800 dark:text-cyan-200 shadow-sm" : "bg-slate-100 text-slate-700 border-slate-300 hover:bg-slate-200 dark:bg-zinc-900/90 dark:text-zinc-400 dark:border-slate-800 dark:hover:bg-zinc-800")">
                        <span class="inline-block w-1.5 h-3 rounded-full flex-shrink-0" style="background-color: @d.TeamColor;"></span>
                        <span>@d.NameAcronym</span>
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
    }
}
